# FloodWay 2.0 Frontend Template (Safe to Commit)
VITE_TELEGRAM_BOT_USERNAME=your_bot_username_here
VITE_API_BASE=http://localhost:8080
VITE_VISION_MOCK=0

# Secrets never go in a VITE_ variable: everything prefixed VITE_ is compiled into the browser bundle.
# The Telegram bot token, the OpenRouter key and the write token live in backend/.env only.
