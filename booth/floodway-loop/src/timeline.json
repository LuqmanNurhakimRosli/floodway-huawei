  "narration": [
    { "id": "n1", "at": 0.6, "text": "In Malaysia, a journey can change when the rain comes." },
    { "id": "n2", "at": 7.4, "text": "When the water rises, knowing where to go matters." },
    { "id": "n3", "at": 13.6, "text": "Meet FloodWay, helping you understand flood risk before you move." },
    { "id": "n4", "at": 19.6, "text": "See the water level through FloodWay's digital twin, so you can understand what is happening around you." },
    { "id": "n5", "at": 27.4, "text": "When conditions change, FloodWay helps you find a route that avoids flooded roads and guides you toward a safe shelter." },
    { "id": "n6", "at": 35.5, "text": "And when you need them to know you're okay, one tap can let your family know." },
    { "id": "n7", "at": 42.5, "text": "FloodWay turns rain and water data, plus forecasting, into a decision you can act on." },
    { "id": "n8", "at": 49.4, "text": "Because every journey is different, but everyone deserves a clearer way to respond." },
    { "id": "n9", "at": 55.8, "text": "FloodWay. See the risk. Find shelter." }
  ],
