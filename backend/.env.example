# FloodWay 2.0 Backend Template (Safe to Commit)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_DEFAULT_CHAT_ID=
HOST=0.0.0.0
PORT=8080
DEV_AUTH=1

# ---- Live Vision (all optional; defaults shown) ----
VISION_DEFAULT_INTERVAL_S=8
VISION_BURST_FRAMES=5
VISION_BURST_GAP_S=0.4
VISION_ANALYZER=classical
VISION_YOLO_WEIGHTS=
VISION_ALLOW_USER_CAMERAS=1
VISION_ALLOW_PRIVATE_URLS=0
VISION_SEED_SAMPLES=1
VISION_ALERT_COOLDOWN_S=300
VISION_DATA_DIR=data
# Testing aid: shift sample scenes in time (seconds) to reach a level on demand
VISION_SAMPLE_CLOCK_OFFSET_S=0

# ---- Secrets (server side only; never prefix with VITE_) ----
# AI assessment of citizen flood photos (POST /api/v1/ai/flood-image-check). Leave both keys empty to disable: the
# app then says "AI check not run" instead of inventing a result. The Gemini API key (Google AI Studio) is tried first;
# OpenRouter is the fallback. Check the current Flash model ID in Google's docs before changing GEMINI_MODEL.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# When set, write endpoints (camera add/remove/preview/test/analyze, Telegram relay, AI check) require
# `Authorization: Bearer <token>`. Leave empty only for local development; set it for any public deployment.
VISION_WRITE_TOKEN=
