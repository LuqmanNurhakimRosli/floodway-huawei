{
  "model_algorithm": "flood_level_forecaster",
  "model_type": "PyTorch",
  "runtime": "python3.7",
  "apis": [
    {
      "protocol": "https",
      "url": "/",
      "method": "post",
      "request": {
        "Content-type": "application/json",
        "data": {
          "type": "object",
          "properties": {
            "rain_mm": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "level_m": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        }
      },
      "response": {
        "Content-type": "application/json",
        "data": {
          "type": "object",
          "properties": {
            "horizons_min": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "p10": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "p50": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "p90": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  ],
  "dependencies": [
    {
      "installer": "pip",
      "packages": [
        {
          "package_name": "numpy",
          "package_version": "1.21.0",
          "restraint": "ATLEAST"
        }
      ]
    }
  ]
}