{
  "name": "floodway-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.14",
    "expo-constants": "~58.0.12",
    "expo-device": "~58.0.5",
    "expo-linking": "~58.0.13",
    "expo-location": "~58.0.17",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.23",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.11",
    "leaflet": "^1.9.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "tsc --noEmit && jest",
    "export:android": "expo export --platform android --output-dir dist",
    "build:apk": "eas build --platform android --profile preview",
    "build:aab": "eas build --platform android --profile production",
    "build:apk:local": "expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ]
  }
}
